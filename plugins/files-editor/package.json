{
  "name": "bb-plugin-files-editor",
  "version": "0.1.6",
  "description": "VS Code-style file explorer and editor for the project or worktree behind a thread: search in files across the whole project, a file tree, editor tabs, syntax-highlighted viewing, find in file, and edit with save.",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Explorer_vibecom",
    "description": "VS Code-style file explorer and editor for the project or worktree behind a thread: search in files across the whole project, a file tree, editor tabs, syntax-highlighted viewing, find in file, and edit with save.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --config vitest.config.ts",
    "pack-viewers": "npm pack ../markdown-view/src ../office-preview/src --pack-destination vendor && mv vendor/vibecommerce-markdown-view-*.tgz vendor/markdown-view.tgz && mv vendor/vibecommerce-office-preview-*.tgz vendor/office-preview.tgz && npm install --package-lock-only --ignore-scripts --no-audit --no-fund ./vendor/markdown-view.tgz ./vendor/office-preview.tgz",
    "link-viewers": "npm install --no-save --ignore-scripts --no-audit --no-fund ../markdown-view/src ../office-preview/src"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@vibecommerce/markdown-view": "file:vendor/markdown-view.tgz",
    "@vibecommerce/office-preview": "file:vendor/office-preview.tgz",
    "pdfjs-dist": "^4.10.38",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "homepage": "https://github.com/abdoutelb/bb-plugin-files-editor#readme",
  "bugs": {
    "url": "https://github.com/abdoutelb/bb-plugin-files-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdoutelb/bb-plugin-files-editor.git"
  },
  "keywords": [
    "bb-plugin",
    "files",
    "file-explorer",
    "grep",
    "full-text-search",
    "search-in-files",
    "file-browser",
    "file-tree",
    "editor",
    "code-editor",
    "text-editor",
    "syntax-highlighting",
    "find-in-file",
    "vscode",
    "workspace"
  ],
  "files": [
    "assets",
    "docs",
    "dist",
    "vendor",
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "hooks",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
